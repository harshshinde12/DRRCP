# Backend env — copy to .env
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Rate limits (requests per window; RMMM R5). Disabled when NODE_ENV=test.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Fraction of free shelter beds below which admins are alerted (0.1 = 10%).
SHELTER_LOW_CAPACITY_FRACTION=0.1
